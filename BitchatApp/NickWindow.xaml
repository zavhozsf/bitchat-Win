<Window x:Class="Bitchat.Windows.App.NickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="nickname" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" Icon="Assets\bitchat.ico"
        Background="#1E1F22" ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock Text="Nickname (max 15 chars)" Foreground="#9AA0A6" Margin="0,0,0,8" />
    <TextBox x:Name="NickBox" FontSize="14" Background="#26282C" Foreground="#E8EAED" BorderBrush="#3A3D42"
             Padding="8,6" KeyDown="NickBox_KeyDown" MaxLength="15" />
    <TextBlock x:Name="HintText" FontSize="11" Foreground="#9AA0A6" Margin="0,6,0,0" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Reset to default" Click="Reset_Click" Background="#2B2D31" Foreground="#FFB4AB"
              BorderThickness="0" Padding="12,6" Margin="0,0,8,0" />
      <Button Content="Cancel" Click="Cancel_Click" Background="#2B2D31" Foreground="#E8EAED" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" />
      <Button Content="OK (pin)" Click="Ok_Click" Background="#4CA8FF" Foreground="White" BorderThickness="0" Padding="16,6" />
    </StackPanel>
  </StackPanel>
</Window>
